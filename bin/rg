#!/usr/bin/env bash
# Generated by scripts/generate-search-shims.sh; edit the generator instead.
name=rg
preferred=/usr/bin/rg
stream_filter=1

# Prefer the system binary, then search PATH while excluding this shim and
# same-file aliases. Resolve to an absolute path, including user-local tools.
real_binary=$preferred
if [[ ! -x $real_binary || $real_binary -ef ${BASH_SOURCE[0]} ]]; then
	real_binary=
	remaining=$PATH
	while :; do
		directory=${remaining%%:*}
		candidate=${directory:-.}/$name
		if [[ -f $candidate && -x $candidate && ! $candidate -ef ${BASH_SOURCE[0]} ]]; then
			real_binary=$(realpath -- "$candidate") || exit 127
			break
		fi
		[[ $remaining == *:* ]] || break
		remaining=${remaining#*:}
	done
fi
if [[ -z $real_binary ]]; then
	printf 'pi-shims: real %s binary not found outside the shim directory\n' "$name" >&2
	exit 127
fi

# Inspect the descriptor type without reading it. A pipe is a deliberate,
# potentially unbounded streaming filter; find/fd do not have stdin modes.
if [[ ${PI_SHIMS_CONFIRM:-} == 1 ]] || { (( stream_filter )) && [[ -p /dev/stdin ]]; }; then
	exec "$real_binary" "$@"
fi

limit=${PI_SHIMS_SEARCH_TIMEOUT:-60s}
timeout -- "$limit" "$real_binary" "$@"
status=$?
if (( status == 124 )); then
	printf 'pi-shims: %s search exceeded %s and was killed; partial output above is incomplete. The scanned range is too broad.\n' "$name" "$limit" >&2
	printf '%s\n' 'Narrow the path; use --include/--glob or -maxdepth/--max-depth as appropriate; exclude .git/node_modules; prefer rg/fd over grep -R/find.' >&2
	printf 'To run untimed: PI_SHIMS_CONFIRM=1, or the real binary: %s\n' "$real_binary" >&2
	exit 77
fi
exit "$status"
