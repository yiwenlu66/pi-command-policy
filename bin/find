#!/usr/bin/env bash
# Generated by scripts/generate-search-shims.sh; edit the generator instead.
name=find
preferred=/usr/bin/find
stream_filter=0

# Prefer the system binary, then search PATH. Canonicalize symlinks before
# rejecting shim copies: two installed packages must never exec each other.
shim_path=$(realpath -- "${BASH_SOURCE[0]}") || exit 127
is_shim() {
	local candidate=$1 manifest=${1%/*}/../package.json
	[[ $candidate -ef $shim_path ]] && return 0
	cmp -s -- "$candidate" "$shim_path" && return 0
	# Different package versions need not have identical script contents.
	[[ -f $manifest ]] && /bin/grep -Eq '"name"[[:space:]]*:[[:space:]]*"(pi-command-policy|pi-shims)"' "$manifest"
}

real_binary=$preferred
if [[ -x $real_binary ]]; then
	real_binary=$(realpath -- "$real_binary") || exit 127
fi
if [[ ! -x $real_binary ]] || is_shim "$real_binary"; then
	real_binary=
	remaining=$PATH
	while :; do
		directory=${remaining%%:*}
		candidate=${directory:-.}/$name
		if [[ -f $candidate && -x $candidate ]]; then
			candidate=$(realpath -- "$candidate") || exit 127
			if ! is_shim "$candidate"; then
				real_binary=$candidate
				break
			fi
		fi
		[[ $remaining == *:* ]] || break
		remaining=${remaining#*:}
	done
fi
if [[ -z $real_binary ]]; then
	printf 'pi-command-policy: real %s binary not found outside the shim directory\n' "$name" >&2
	exit 127
fi

# Inspect the descriptor type without reading it. A pipe is a deliberate,
# potentially unbounded streaming filter; find/fd do not have stdin modes.
if [[ ${PI_COMMAND_POLICY_CONFIRM:-} == 1 || ${PI_SHIMS_CONFIRM:-} == 1 ]] || { (( stream_filter )) && [[ -p /dev/stdin ]]; }; then
	exec "$real_binary" "$@"
fi

limit=${PI_COMMAND_POLICY_SEARCH_TIMEOUT:-${PI_SHIMS_SEARCH_TIMEOUT:-60s}}
timeout -- "$limit" "$real_binary" "$@"
status=$?
if (( status == 124 )); then
	printf 'pi-command-policy: %s search exceeded %s and was killed; partial output above is incomplete. The scanned range is too broad.\n' "$name" "$limit" >&2
	printf '%s\n' 'Narrow the path; use --include/--glob or -maxdepth/--max-depth as appropriate; exclude .git/node_modules; prefer rg/fd over grep -R/find.' >&2
	printf 'To run untimed: PI_COMMAND_POLICY_CONFIRM=1 (legacy PI_SHIMS_CONFIRM=1 also works), or the real binary: %s\n' "$real_binary" >&2
	exit 77
fi
exit "$status"
